{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sync-owner-directory",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/competitor-alerts",
      "schedule": "0 3 * * 2"
    }
  ]
}

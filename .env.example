DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@host/db?sslmode=require
# Required by src/lib/env.ts. Public origin used to build absolute links in outbound email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your-secret-at-least-32-characters-long
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
RESEND_API_KEY=re_your_resend_api_key
# Optional. Sender for all outbound mail incl. magic-link sign-in emails. Must be on the
# Resend-verified noreply.hellosugar.salon subdomain. Defaults in src/lib/email.ts.
# EMAIL_FROM=Hello Sugar Marketplace <marketplace@noreply.hellosugar.salon>
# Non-production only: redirect ALL outbound mail (incl. sign-in links) to this inbox.
# Without it, non-production sends nothing and magic-link URLs are printed to the server log.
# EMAIL_OVERRIDE=you@hellosugar.salon
INITIAL_ADMIN_EMAIL=admin@hellosugar.salon
GOOGLE_WORKSPACE_DOMAIN=hellosugar.salon

# Vercel Blob (photo uploads)
# Get from: Vercel Dashboard > Storage > Create Database > Blob > Connect
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# MapTiler (map tiles and location autocomplete)
# Get from: MapTiler Cloud (https://cloud.maptiler.com) -> Account -> API Keys
# Restrict key to production domain in MapTiler Cloud -> API Keys -> Edit -> Allowed URLs
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key

# Server-side MapTiler key for the geocoding backfill (scripts/geocode-locations.ts).
# Use a SEPARATE, UNRESTRICTED key (no Allowed-URL domain lock): server-side requests
# send no Origin header, so a domain-restricted key is rejected.
MAPTILER_API_KEY=your_unrestricted_server_maptiler_api_key

# Hello Sugar Internal API (Phase 4)
HS_INTERNAL_API_URL=https://api.hellosugar.salon/v1
HS_INTERNAL_API_TOKEN=your-internal-api-token

# BigQuery (real KPI/financial data + owner directory). SERVER-ONLY. Never expose to the client.
BIGQUERY_PROJECT_ID=even-affinity-388602
# Local dev: path to the downloaded service-account key file (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/bq-key.json
# Vercel / prod: full service-account JSON as a single-line string, parsed from the
# env var (NOT a file path — runs serverless). Set this in the Vercel project env.
# Falls back to the legacy BIGQUERY_CREDENTIALS name if GCP_SERVICE_ACCOUNT_JSON is unset.
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# GitHub repository_dispatch for the brand-request pipeline. Fine-grained PAT
# scoped to Hello-Brands/competitor-monitor with Contents read/write (dispatches).
GITHUB_DISPATCH_TOKEN=github_pat_xxxxx
